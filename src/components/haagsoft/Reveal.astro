---
// Fade-and-rise when scrolled into view, via AstroWind's <Intersect /> observer.
// Content is visible without JS and for reduced-motion users.
export interface Props {
  as?: string;
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag
  class:list={[
    'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
    className,
  ]}
>
  <slot />
</Tag>
