---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Section from '~/components/haagsoft/Section.astro';
import SectionLabel from '~/components/haagsoft/SectionLabel.astro';
import Reveal from '~/components/haagsoft/Reveal.astro';
import ProjectCard from '~/components/haagsoft/ProjectCard.astro';
import { projects } from '~/data/projects';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Haagsoft — Reliable agentic AI, built in TypeScript',
  ignoreTitleTemplate: true,
};

const EMAIL = 'devguy@duck.com';

const marquee = [
  'Agentic reliability',
  'North star first',
  'Spec → eval → ship',
  'Evals before vibes',
  'Harness engineering',
  'Human in the loop',
  'Type-safe TypeScript',
];

const northStar = [
  {
    title: 'Define it',
    text: 'One written sentence of what good looks like, plus constraints and a definition of done, in a spec the agent reads on every run. If I can’t write it down, the agent can’t follow it.'
  },
  {
    title: 'Measure it',
    text: 'Evals grade each run against the north star: fixed datasets, scored outputs, regressions caught before users see them. A prompt or model change becomes a measured decision.',
  },
  {
    title: 'Hold it',
    text: 'The harness keeps the agent on course: typed tool contracts, bounded loops, guardrails, retries, tracing and a human checkpoint wherever a wrong move is expensive.',
  },
];

const loop = [
  { step: 'Spec', text: 'Goal, constraints, definition of done. Short, written, versioned with the code.' },
  {
    step: 'Context',
    text: 'Only what the agent needs: the right files, tools and examples, nothing that distracts it.',
  },
  { step: 'Build', text: 'Small slices the agent can finish and I can read in one sitting.' },
  {
    step: 'Verify',
    text: 'Tests where state changes, evals where the model decides. Output is a claim until checked.',
  },
  { step: 'Review', text: 'I read every diff. Autonomy is earned by eval scores, not granted by optimism.' },
];

const principles = [
  {
    title: 'North star before code',
    text: 'Every build starts with what good looks like, written down. The spec, the evals and the harness all point at it, so the agent has something to follow and I have something to measure against.'
  },
  {
    title: 'Verify, don’t trust',
    text: 'Generating code and behaviour is cheap now; checking it is the real work. I design for review: small diffs, typed boundaries, tests on state changes and evals on anything the model decides.'
  },
  {
    title: 'Constrain the agent',
    text: 'Least-privilege tools, schemas the model can’t wriggle out of, bounded loops and explicit stop conditions. Reliability comes from the boundaries, not from a cleverer prompt.',
  },
  {
    title: 'Keep a human where wrong is expensive',
    text: 'Irreversible or costly actions get an approval step. As an agent’s eval scores hold up over time, the leash gets longer; never before.',
  },
  {
    title: 'Ship small, stay swappable',
    text: 'Spec-driven slices, semantic HTML first, one language full-stack. Every provider is a rental, so Railway, Fly.io, Vercel, Vultr or Hetzner is chosen because the exit is cheap.',
  },
];

const stack = [
  { dt: 'Frontend', dd: 'React + Vite · Astro · TypeScript · shadcn/ui · Tailwind · Vue for ML dashboards' },
  { dt: 'Backend', dd: 'Express · tRPC · PostgreSQL via Drizzle ORM · Go for glue services' },
  {
    dt: 'AI & agentic',
    dd: 'Claude API (vision + text) · LangChain · type-safe tool schemas · RAG pipelines · vector databases',
  },
  {
    dt: 'Reliability',
    dd: 'North-star specs · evals and graded datasets · tracing · harness engineering · guardrails, retries and human checkpoints',
  },
  { dt: 'ML & data', dd: 'Python · scikit-learn · pandas · numpy' },
  { dt: 'Infra & delivery', dd: 'Docker · Kubernetes · GitHub Actions · Terraform' },
  { dt: 'Hosting', dd: 'Vercel · Railway · Fly.io · Vultr · Hetzner storage' },
];

// Structured data for the site and its publisher, built from `src/config.yaml`.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    founder: { '@type': 'Person', name: 'Devguy' },
    sameAs: ['https://github.com/oreillyross'],
    description: METADATA?.description,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <section class="relative overflow-hidden md:-mt-[76px] not-prose" id="top">
    <div aria-hidden="true">
      <div class="hs-glow -top-40 -right-32 h-[36rem] w-[36rem] bg-lime"></div>
      <div class="hs-glow top-64 -left-40 h-[28rem] w-[28rem] bg-violet"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-10 md:pt-[140px] pb-16 md:pb-24">
      <div class="flex flex-wrap gap-2 font-mono text-xs uppercase tracking-[0.14em]">
        <span class="rounded-full border border-rule px-3 py-1 text-muted">Solo studio · The Hague, NL</span>
        <span class="inline-flex items-center gap-2 rounded-full border border-rule bg-surface px-3 py-1 text-default">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-lime opacity-75 motion-safe:animate-ping"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-lime ring-1 ring-ink/20"></span>
          </span>
          Available for one new build
        </span>
      </div>

      <h1
        class="mt-8 font-heading font-bold text-heading tracking-[-0.04em] leading-[0.92] text-[clamp(3.25rem,11vw,8.5rem)]"
      >
        <span class="hs-line"><span>Agents that</span></span>
        <span class="hs-line"><span>follow the</span></span>
        <span class="hs-line"><span class="text-primary">north star.</span></span>
      </h1>

      <div class="mt-10 grid gap-8 md:grid-cols-[minmax(0,34rem)_auto] md:items-end md:justify-between">
        <p class="text-lg md:text-xl text-muted">
          I'm <strong class="text-heading font-semibold">Devguy</strong>. Haagsoft is my one-person studio. I build
          agentic AI products in type-safe TypeScript and make them reliable: a written goal, evals that measure it and
          a harness that keeps every run pointed at it.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="#work">See the work</a>
          <a class="btn" href="#contact">Let's talk</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="border-y border-rule bg-fill text-on-fill overflow-hidden not-prose" aria-hidden="true">
    <div class="hs-marquee__track flex w-max whitespace-nowrap py-4 font-heading text-2xl md:text-3xl font-bold">
      {
        [0, 1].map(() => (
          <span class="flex">
            {marquee.map((item) => (
              <span class="px-6">
                {item} <span class="ml-6 opacity-50">✦</span>
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <!-- 01 North star -->
  <Section id="north-star">
    <Reveal><SectionLabel n="01">The north star</SectionLabel></Reveal>
    <p
      class="hs-light-up mt-8 font-heading text-heading font-medium tracking-[-0.02em] leading-[1.12] text-[clamp(1.75rem,4.2vw,3.25rem)] text-balance"
    >
      An agent without a north star is just a fast way to be wrong. Agentic reliability starts by writing down what
      <span class="text-primary">good</span> looks like, then building everything else to point at it.
    </p>
    <ol class="mt-12 grid list-none gap-6 p-0 md:grid-cols-3">
      {
        northStar.map(({ title, text }, i) => (
          <Reveal as="li" class="border-t-2 border-primary pt-6">
            <span class="font-mono text-sm text-primary">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-heading text-2xl font-bold text-heading">{title}</h3>
            <p class="mt-3 text-muted">{text}</p>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <!-- 02 The loop -->
  <Section id="loop" band>
    <Reveal><SectionLabel n="02">The loop</SectionLabel></Reveal>
    <Reveal as="h2" class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading text-balance">
      AI makes the first draft fast. Reliability is the rest.
    </Reveal>
    <Reveal as="p" class="mt-6 max-w-2xl text-lg text-muted">
      Getting an agent to look right is easy. Getting it to be right on the hundredth run is engineering. Every build
      goes round the same loop, and nothing ships past a step it hasn't passed.
    </Reveal>
    <ol class="mt-12 grid list-none gap-4 p-0 md:grid-cols-5">
      {
        loop.map(({ step, text }, i) => (
          <Reveal as="li" class="rounded-2xl border border-rule bg-surface p-5">
            <span class="font-mono text-sm text-primary">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-heading text-xl font-bold text-heading">{step}</h3>
            <p class="mt-2 text-sm text-muted">{text}</p>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <!-- 03 How I work: sticky card stack on desktop -->
  <Section id="studio">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start">
        <Reveal><SectionLabel n="03">How I work</SectionLabel></Reveal>
        <Reveal
          as="h2"
          class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading text-balance"
        >
          Five rules that decide every trade-off.
        </Reveal>
      </div>
      <ol class="list-none p-0 m-0 space-y-6">
        {
          principles.map((p, i) => (
            <li
              class="md:sticky rounded-2xl border border-rule bg-surface p-6 md:p-8 shadow-sm"
              style={`top: calc(7rem + ${i} * 1.25rem)`}
            >
              <span class="font-mono text-sm text-primary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-heading text-2xl font-bold tracking-tight text-heading">{p.title}</h3>
              <p class="mt-3 text-muted">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- 03 Work -->
  <Section id="work">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <Reveal><SectionLabel n="04">Active builds</SectionLabel></Reveal>
        <Reveal as="h2" class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading">
          Proof, in public.
        </Reveal>
      </div>
      <Reveal as="p" class="max-w-sm text-muted">
        Each build is a testbed for the loop above. Live apps open on their own haagsoft.xyz subdomain; the rest is
        built in the open.
      </Reveal>
    </div>
    <ul class="mt-12 grid list-none gap-6 p-0 md:grid-cols-2">
      {
        projects.map((project, i) => (
          <Reveal as="li" class={i === 0 ? 'md:col-span-2' : ''}>
            <ProjectCard project={project} />
          </Reveal>
        ))
      }
    </ul>
  </Section>

  <!-- 04 Stack -->
  <Section id="stack" band>
    <Reveal><SectionLabel n="05">Stack</SectionLabel></Reveal>
    <Reveal as="h2" class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading">
      Type-safe from database to tool schema.
    </Reveal>
    <dl class="mt-12 border-t border-rule">
      {
        stack.map(({ dt, dd }) => (
          <Reveal class="grid gap-2 border-b border-rule py-5 md:grid-cols-[14rem_1fr] md:gap-8">
            <dt class="font-mono text-sm uppercase tracking-[0.12em] text-primary">{dt}</dt>
            <dd class="text-lg text-default">{dd}</dd>
          </Reveal>
        ))
      }
    </dl>
  </Section>

  <!-- 06 Human in the loop -->
  <Section container="max-w-5xl">
    <div aria-hidden="true" slot="bg">
      <div class="hs-glow top-10 right-0 h-80 w-80 bg-blue"></div>
    </div>
    <Reveal><SectionLabel n="06">Human in the loop</SectionLabel></Reveal>
    <blockquote class="mt-8">
      <p
        class="hs-light-up font-heading text-heading font-medium tracking-[-0.02em] leading-[1.15] text-[clamp(1.6rem,3.6vw,2.75rem)] text-balance"
      >
        Claude is a collaborator, not autocomplete. It drafts fast; I stay accountable. Every output is a pull request
        from a quick, confident junior: read it, run it, test it, then merge it.
      </p>
    </blockquote>
    <Reveal as="p" class="mt-8 max-w-2xl text-muted">
      Reading AINews (Latent Space), The Neuron and TLDR; studying agentic patterns via Matt Pocock and Jack Herrington.
    </Reveal>
  </Section>

  <!-- Writing -->
  <div class="bg-band">
    <BlogLatestPosts
      id="writing"
      title="Build logs & decisions"
      information="How the apps above were built, what broke, and why the design ended up the way it did."
      count={3}
    />
  </div>

  <!-- 06 Contact -->
  <Section id="contact" container="max-w-6xl">
    <div aria-hidden="true" slot="bg">
      <div class="hs-glow -bottom-40 left-1/4 h-[30rem] w-[30rem] bg-lime"></div>
      <div class="hs-glow -top-20 right-0 h-80 w-80 bg-amber"></div>
    </div>
    <Reveal><SectionLabel n="07">Contact</SectionLabel></Reveal>
    <h2
      class="mt-8 font-heading font-bold text-heading tracking-[-0.04em] leading-[0.95] text-[clamp(2.75rem,8vw,6.5rem)]"
    >
      Let's build an agent <span class="text-primary">you can trust.</span>
    </h2>
    <div class="mt-12 flex flex-wrap gap-3">
      <a class="btn-primary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a class="btn" href="https://github.com/oreillyross" rel="me noopener">github.com/oreillyross</a>
      <a class="btn" href="/about">More about me</a>
    </div>
  </Section>
</Layout>
