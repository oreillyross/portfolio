---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Section from '~/components/haagsoft/Section.astro';
import SectionLabel from '~/components/haagsoft/SectionLabel.astro';
import Reveal from '~/components/haagsoft/Reveal.astro';
import ProjectCard from '~/components/haagsoft/ProjectCard.astro';
import { projects } from '~/data/projects';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: "Haagsoft — Ross O'Reilly, agentic AI SaaS",
  ignoreTitleTemplate: true,
};

const EMAIL = 'devguy@duck.com';

const marquee = [
  'TypeScript everywhere',
  'Evals before vibes',
  'Agent reliability',
  'Harness engineering',
  'RAG pipelines',
  'Vector search',
  'Sustainable software',
];

const principles = [
  {
    title: 'Ship iteratively, spec-driven',
    text: 'Write the spec, cut it to the smallest honest slice, get it live. Complexity is layered onto something real — never designed into something imaginary.',
  },
  {
    title: 'Semantic HTML first',
    text: 'Start with the bare minimum markup that works for everyone. Polish, animation and component libraries arrive after the thing is usable, not instead of it.',
  },
  {
    title: 'Hot-swappable infrastructure',
    text: 'Every provider is a rental. Railway, Fly.io, Vercel, Vultr, Hetzner — chosen because the exit is cheap, and the app can move in an afternoon.',
  },
  {
    title: 'Right-sized tooling',
    text: 'Solopreneur-appropriate infra beats enterprise ceremony. One language full-stack, one deploy target, one person who can hold the whole system in their head.',
  },
  {
    title: 'Test what changes state — eval what thinks',
    text: 'Tests follow interaction and data, the moments where state moves. Agent behaviour gets evals: fixed datasets, graded runs, regressions caught before users see them.',
  },
];

const stack = [
  { dt: 'Frontend', dd: 'React + Vite · Astro · TypeScript · shadcn/ui · Tailwind · Vue for ML dashboards' },
  { dt: 'Backend', dd: 'Express · tRPC · PostgreSQL via Drizzle ORM · Go for glue services' },
  {
    dt: 'AI & agentic',
    dd: 'Claude API (vision + text) · LangChain · type-safe tool schemas · RAG pipelines · vector databases',
  },
  { dt: 'Reliability', dd: 'Evals and graded datasets · tracing · harness engineering · guardrails and retries' },
  { dt: 'ML & data', dd: 'Python · scikit-learn · pandas · numpy' },
  { dt: 'Infra & delivery', dd: 'Docker · Kubernetes · GitHub Actions · Terraform' },
  { dt: 'Hosting', dd: 'Vercel · Railway · Fly.io · Vultr · Hetzner storage' },
];

// Structured data for the site and its publisher, built from `src/config.yaml`.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    founder: { '@type': 'Person', name: "Ross O'Reilly" },
    sameAs: ['https://github.com/oreillyross'],
    description: METADATA?.description,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <section class="relative overflow-hidden md:-mt-[76px] not-prose" id="top">
    <div aria-hidden="true">
      <div class="hs-glow -top-40 -right-32 h-[36rem] w-[36rem] bg-lime"></div>
      <div class="hs-glow top-64 -left-40 h-[28rem] w-[28rem] bg-violet"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 pt-10 md:pt-[140px] pb-16 md:pb-24">
      <div class="flex flex-wrap gap-2 font-mono text-xs uppercase tracking-[0.14em]">
        <span class="rounded-full border border-rule px-3 py-1 text-muted">Solo studio · Durban, ZA</span>
        <span class="inline-flex items-center gap-2 rounded-full border border-rule bg-surface px-3 py-1 text-default">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-lime opacity-75 motion-safe:animate-ping"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-lime ring-1 ring-ink/20"></span>
          </span>
          Available for one new build
        </span>
      </div>

      <h1
        class="mt-8 font-heading font-bold text-heading tracking-[-0.04em] leading-[0.92] text-[clamp(3.25rem,11vw,8.5rem)]"
      >
        <span class="hs-line"><span>Agentic</span></span>
        <span class="hs-line"><span>AI <em class="not-italic text-primary">SaaS</em>,</span></span>
        <span class="hs-line"><span>shipped in</span></span>
        <span class="hs-line"><span>slices.</span></span>
      </h1>

      <div class="mt-10 grid gap-8 md:grid-cols-[minmax(0,34rem)_auto] md:items-end md:justify-between">
        <p class="text-lg md:text-xl text-muted">
          I'm <strong class="text-heading font-semibold">Ross O'Reilly</strong>. Haagsoft is my one-person studio:
          small, independently deployable AI products in type-safe TypeScript, made reliable with evals and a proper
          harness. Spec-driven, MVP-first, no over-planning.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="#work">See the work</a>
          <a class="btn" href="#contact">Let's talk</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="border-y border-rule bg-fill text-on-fill overflow-hidden not-prose" aria-hidden="true">
    <div class="hs-marquee__track flex w-max whitespace-nowrap py-4 font-heading text-2xl md:text-3xl font-bold">
      {
        [0, 1].map(() => (
          <span class="flex">
            {marquee.map((item) => (
              <span class="px-6">
                {item} <span class="ml-6 opacity-50">✦</span>
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <!-- 01 Manifesto -->
  <Section id="manifesto">
    <Reveal><SectionLabel n="01">Manifesto</SectionLabel></Reveal>
    <p
      class="hs-light-up mt-8 font-heading text-heading font-medium tracking-[-0.02em] leading-[1.12] text-[clamp(1.75rem,4.2vw,3.25rem)] text-balance"
    >
      Haagsoft is a microservices-first studio run by one person. Many small, independently deployable apps — each on
      its own <span class="text-primary">haagsoft.xyz</span> subdomain — that stand alone or compound, sized to ship fast
      and prove value before they earn more investment.
    </p>
    <div class="mt-12 grid gap-8 md:grid-cols-2 text-lg text-muted">
      <Reveal as="p">
        The long game is to be a boutique agentic AI developer: LLM-powered interfaces, real-time inference, vector
        search and semantic UX applied to ordinary problems — pantries, news, habits, households.
      </Reveal>
      <Reveal as="p">
        The short game is a live URL. Semantic HTML before component libraries. Hot-swappable infrastructure over vendor
        lock-in. Tests where state changes, evals where the model decides.
      </Reveal>
    </div>
  </Section>

  <!-- 02 How I work: sticky card stack on desktop -->
  <Section id="studio" band>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start">
        <Reveal><SectionLabel n="02">How I work</SectionLabel></Reveal>
        <Reveal
          as="h2"
          class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading text-balance"
        >
          Five rules that decide every trade-off.
        </Reveal>
      </div>
      <ol class="list-none p-0 m-0 space-y-6">
        {
          principles.map((p, i) => (
            <li
              class="md:sticky rounded-2xl border border-rule bg-surface p-6 md:p-8 shadow-sm"
              style={`top: calc(7rem + ${i} * 1.25rem)`}
            >
              <span class="font-mono text-sm text-primary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-heading text-2xl font-bold tracking-tight text-heading">{p.title}</h3>
              <p class="mt-3 text-muted">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- 03 Work -->
  <Section id="work">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <Reveal><SectionLabel n="03">Active builds</SectionLabel></Reveal>
        <Reveal as="h2" class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading">
          In progress, in public.
        </Reveal>
      </div>
      <Reveal as="p" class="max-w-sm text-muted">
        Live apps open on their own subdomain. Everything else is being built in the open.
      </Reveal>
    </div>
    <ul class="mt-12 grid list-none gap-6 p-0 md:grid-cols-2">
      {
        projects.map((project, i) => (
          <Reveal as="li" class={i === 0 ? 'md:col-span-2' : ''}>
            <ProjectCard project={project} />
          </Reveal>
        ))
      }
    </ul>
  </Section>

  <!-- 04 Stack -->
  <Section id="stack" band>
    <Reveal><SectionLabel n="04">Stack</SectionLabel></Reveal>
    <Reveal as="h2" class="mt-6 font-heading text-4xl md:text-5xl font-bold tracking-tight text-heading">
      One language, full-stack velocity.
    </Reveal>
    <dl class="mt-12 border-t border-rule">
      {
        stack.map(({ dt, dd }) => (
          <Reveal class="grid gap-2 border-b border-rule py-5 md:grid-cols-[14rem_1fr] md:gap-8">
            <dt class="font-mono text-sm uppercase tracking-[0.12em] text-primary">{dt}</dt>
            <dd class="text-lg text-default">{dd}</dd>
          </Reveal>
        ))
      }
    </dl>
  </Section>

  <!-- 05 The coworker -->
  <Section container="max-w-5xl">
    <div aria-hidden="true" slot="bg">
      <div class="hs-glow top-10 right-0 h-80 w-80 bg-blue"></div>
    </div>
    <Reveal><SectionLabel n="05">The coworker</SectionLabel></Reveal>
    <blockquote class="mt-8">
      <p
        class="hs-light-up font-heading text-heading font-medium tracking-[-0.02em] leading-[1.15] text-[clamp(1.6rem,3.6vw,2.75rem)] text-balance"
      >
        Claude is a collaborative coworker, not autocomplete — an iterative development partner for architecture, review
        and the harness engineering layer that turns a model into a product.
      </p>
    </blockquote>
    <Reveal as="p" class="mt-8 max-w-2xl text-muted">
      Reading AINews (Latent Space), The Neuron and TLDR; studying agentic patterns via Matt Pocock and Jack Herrington.
    </Reveal>
  </Section>

  <!-- Writing -->
  <div class="bg-band">
    <BlogLatestPosts
      id="writing"
      title="Build logs & decisions"
      information="How the apps above were built, what broke, and why the design ended up the way it did."
      count={3}
    />
  </div>

  <!-- 06 Contact -->
  <Section id="contact" container="max-w-6xl">
    <div aria-hidden="true" slot="bg">
      <div class="hs-glow -bottom-40 left-1/4 h-[30rem] w-[30rem] bg-lime"></div>
      <div class="hs-glow -top-20 right-0 h-80 w-80 bg-amber"></div>
    </div>
    <Reveal><SectionLabel n="06">Contact</SectionLabel></Reveal>
    <h2
      class="mt-8 font-heading font-bold text-heading tracking-[-0.04em] leading-[0.95] text-[clamp(2.75rem,8vw,6.5rem)]"
    >
      Let's build something small <span class="text-primary">that compounds.</span>
    </h2>
    <div class="mt-12 flex flex-wrap gap-3">
      <a class="btn-primary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a class="btn" href="https://github.com/oreillyross" rel="me noopener">github.com/oreillyross</a>
      <a class="btn" href="/about">More about me</a>
    </div>
  </Section>
</Layout>
